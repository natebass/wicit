# Welcome to the WICit (findwic.com) environment variables.
# IMPORTANT: This file is intended to be included in version control. Do not add sensative environemnt variables here.
# Copy this file to `.env` and fill in real values.
# It is read by src/js/lib/config.js.

# Mapbox raster tile template. This needs to be added in .env to avoid GitHub secret scanning. However, it is still
# included in the Vite client bundle so it is public. Restrict access to specific URLs in Mapbox's settings.
VITE_MAPBOX_INTEGRATION_URL=""

# California WIC vendor locations (CHHS datastore SQL API).
VITE_LOCATIONS_API_URL="https://data.chhs.ca.gov/api/3/action/datastore_search_sql"
VITE_LOCATIONS_RESOURCE_ID="ee10b67b-2b93-47e7-aa41-cecfbbd32e17"
